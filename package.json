{
  "name": "rp2040js-circuitpython",
  "version": "1.0.0",
  "description": "CircuitPython Simulator using RP2040js",
  "main": "src/index.js",
  "scripts": {
    "start": "node --no-warnings src/index.js",
    "mountFS": "sudo mount -o loop,uid=$(id -u $USER),gid=$(id -g $USER) firmware/firmfs.img ./mnt_dir && echo use npm run unmountFS to safly unmount the filesystem",
    "unmountFS": "sudo umount ./mnt_dir",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wokwi/rp2040js-circuitpython.git"
  },
  "keywords": [
    "circuitpython",
    "simulation",
    "rp2040",
    "raspberry pi pico",
    "rp2040js",
    "simulator"
  ],
  "author": "Uri Shaked <uri@wokwi.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wokwi/rp2040js-circuitpython/issues"
  },
  "homepage": "https://github.com/wokwi/rp2040js-circuitpython#readme",
  "dependencies": {
    "rp2040js": "^0.12.0",
    "uf2": "^1.0.0"
  },
  "type": "commonjs"
}
