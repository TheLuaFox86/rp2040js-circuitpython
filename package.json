{
  "name": "rp2040js-circuitpython",
  "version": "0.0.1",
  "description": "CircuitPython Simulator using RP2040js. Forked from The Creator Of Wokwi",
  "main": "src/index.js",
  "bin": {
    "rp2040sim": "bin/cli.js"
  },
  "scripts": {
    "start": "node --no-warnings src/index.js",
    "mount": "mkdir -p ./mnt_dir && sudo mount -o loop,uid=$(id -u),gid=$(id -g) $IMG ./mnt_dir && echo 'use npm run unmount to safely unmount the filesystem'",
    "unmount": "sudo umount ./mnt_dir",
    "updateBoard": "node src/createBoardJSON.js",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheLuaFox86/rp2040js-circuitpython"
  },
  "keywords": [
    "circuitpython",
    "simulation",
    "rp2040",
    "raspberry pi pico",
    "rp2040js",
    "simulator"
  ],
  "author": "Uri Shaked <uri@wokwi.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wokwi/rp2040js-circuitpython/issues"
  },
  "homepage": "https://github.com/wokwi/rp2040js-circuitpython#readme",
  "dependencies": {
    "rp2040js": "^0.12.0",
    "uf2": "^1.0.0"
  },
  "type": "commonjs"
}
